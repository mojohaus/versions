  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/mojohaus/versions/issues</url>
  </issueManagement>

  <ciManagement>
    <system>GitHub</system>
    <url>https://github.com/mojohaus/versions/actions</url>
  </ciManagement>

  <properties>
    <mavenVersion>3.9.16</mavenVersion>
    <!-- the plugin still runs on, and builds with, Maven 3.6.3 -->
    <minimalMavenBuildVersion>3.6.3</minimalMavenBuildVersion>

    <doxiaVersion>2.1.0</doxiaVersion>
    <doxia-sitetoolsVersion>2.1.0</doxia-sitetoolsVersion>
    <reportingApiVersion>4.0.0</reportingApiVersion>
    <reportingImplVersion>4.0.0</reportingImplVersion>

    <mockitoVersion>4.11.0</mockitoVersion>
    <woodstoxVersion>7.3.0</woodstoxVersion>
    <stax2ApiVersion>4.3.1</stax2ApiVersion>

    <!-- dotted property can not be used in .vm -->
    <pluginVersion>${project.version}</pluginVersion>
    <sitePluginVersion>${maven-site-plugin.version}</sitePluginVersion>
    <sisuMavenPluginVersion>${sisu-maven-plugin.version}</sisuMavenPluginVersion>
    <fluidoVersion>${maven-fluido-skin.version}</fluidoVersion>
    <modelloNamespaceRuleVersion>3.0.0</modelloNamespaceRuleVersion>
    <modelloNamespaceReportVersion>2.0.0</modelloNamespaceReportVersion>
    <byteBuddyVersion>1.18.14</byteBuddyVersion>

    <!-- use the same version as in Maven core -->
    <mavenResolverVersion>1.9.27</mavenResolverVersion>
    <sisuVersion>1.1.0</sisuVersion>

    <scmpublish.content>${project.build.directory}/staging/versions</scmpublish.content>
    <!-- one IT per core: each IT is a short-lived Maven JVM, and at 0.75C one core of the 4-vCPU CI runners stays idle -->
    <invoker.parallelThreads>1C</invoker.parallelThreads>
    <!-- a rerun starts from the POMs the failed run already rewrote, so it only hides the real error -->
    <invoker.rerunFailingTestsCount>0</invoker.rerunFailingTestsCount>
    <!-- mono-module doesn't require site:stage for scm-publish -->
    <project.build.outputTimestamp>2026-09-11T20:49:26Z</project.build.outputTimestamp>
  </properties>

